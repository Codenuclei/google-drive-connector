# Copy this file to ".env" and fill in the values.
# See README.md for how to obtain these from Google Cloud Console.

# OAuth 2.0 Client (Web application) credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# API key used client-side by the Google Picker (restrict it to the Picker API + your domain)
GOOGLE_API_KEY=

# Any long random string, used to sign the session cookie
SESSION_SECRET=change-this-to-a-random-string

# Port the app listens on
PORT=3000
