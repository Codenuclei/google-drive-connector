# Copy this file to ".env" and fill in the values.
# See README.md for how to obtain these from Google Cloud Console.

# OAuth 2.0 Client (Web application) credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# API key used client-side by the Google Picker (restrict it to the Picker API + your domain)
GOOGLE_API_KEY=

# Any long random string, used to sign the session cookie
SESSION_SECRET=change-this-to-a-random-string

# Port the app listens on
PORT=3000

# Background sync: poll connected Drive folders and notify indexers when files change.
SYNC_POLL_INTERVAL_SECONDS=30

# Follow Google Drive folder shortcuts when listing the connected tree (set to 0 to disable).
FOLLOW_SHORTCUT_FOLDERS=1

# Comma-separated webhook URLs.
WEBHOOK_URLS=http://localhost:8003/api/v1/webhook/drive

# Shared secret — must match WEBHOOK_SECRET in the SVS .env
WEBHOOK_SECRET=change-this-webhook-secret
